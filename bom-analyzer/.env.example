# Copy this file to .env and fill in the credentials you have.
# Either supplier alone is enough to start; configure both to get the
# side-by-side comparison.

# ── DigiKey ────────────────────────────────────────────────────────────────
# Register a free app at https://developer.digikey.com/ and add the
# "Product Information" API to it. Use the Production client ID and secret
# (a Sandbox app returns fixed demo data, not your real catalogue).
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=

# Set to true to hit DigiKey's sandbox host instead of production.
DIGIKEY_SANDBOX=false

# Locale for pricing and availability.
DIGIKEY_SITE=US
DIGIKEY_LANGUAGE=en
DIGIKEY_CURRENCY=USD

# ── Mouser ─────────────────────────────────────────────────────────────────
# Request a free Search API key at https://www.mouser.com/api-hub/
# (the Search API key is the one this app uses, not the Order API key).
MOUSER_API_KEY=
MOUSER_CURRENCY=USD

# ── TrustedParts ───────────────────────────────────────────────────────────
# Free key: register at https://www.trustedparts.com/, then request API access
# under Additional Features on the My Account page. The key arrives as "Trial"
# with an expiry — email user-requests@trustedparts.com to make it Active.
#
# TrustedParts aggregates many authorized distributors, so one lookup returns
# every distributor that stocks the part. Note it reports no lead time, and
# LifecycleRisk / SupplyChainRisk are only populated if your account is
# approved for them.
TRUSTEDPARTS_API_KEY=

TRUSTEDPARTS_CURRENCY=USD
TRUSTEDPARTS_COUNTRY=US
TRUSTEDPARTS_LANGUAGE=en

# Identify this application to TrustedParts, who ask that it be accurate.
TRUSTEDPARTS_USER_AGENT=BOM-Supplier-Analyzer/1.0

# Comma-separated distributor names to restrict the search to. Leave blank to
# search all authorized distributors (the usual choice).
# TRUSTEDPARTS_DISTRIBUTORS=

# Return only distributors with stock on hand.
TRUSTEDPARTS_IN_STOCK_ONLY=false

# Use TrustedParts' cached data instead of real-time distributor feeds. Faster
# and lighter on their systems, but less accurate — leave false unless you are
# making high-volume requests.
TRUSTEDPARTS_USE_CACHED_DATA=false

# ── Nexar (alternative parts) ──────────────────────────────────────────────
# Nexar is Altium's API, and it is not a supplier: it is asked what could be
# used INSTEAD of a part, and only for parts already found to be obsolete,
# NRND, end of life or unavailable. It never runs as part of a BOM analysis, so
# a free-tier quota is spent only on parts you have decided are in trouble.
#
# Sign up at https://nexar.com/, create an application, and take the client ID
# and secret from it. The Supply scope is what this needs.
NEXAR_CLIENT_ID=
NEXAR_CLIENT_SECRET=

# OAuth scope requested. Leave as-is unless Nexar tells you otherwise.
# NEXAR_SCOPE=supply.domain

# How many alternatives to keep per part.
# NEXAR_ALTERNATIVES_LIMIT=12

# Parallel Nexar requests. Their rate limits are tighter than the suppliers'.
# NEXAR_CONCURRENCY=2

# Largest batch of parts accepted in one alternatives request.
# MAX_ALTERNATIVE_PARTS=50

# Nexar's API is GraphQL, so the request is one query rather than an endpoint.
# If their schema moves and a field name changes, point this at a file holding
# your own query instead of waiting for a code change. It must take $q (String!)
# and $limit (Int!) and return supSearchMpn.results.part.
# NEXAR_QUERY_FILE=./nexar-query.graphql

# ── Server ─────────────────────────────────────────────────────────────────
PORT=8787
HOST=0.0.0.0

# Comma-separated list of origins allowed to call the API, or * for any.
# Narrow this if you host the frontend separately from the backend.
ALLOWED_ORIGINS=*

# How long supplier answers are reused before being re-fetched. Both free
# tiers have daily call quotas, so caching keeps repeat runs cheap.
CACHE_TTL_HOURS=6

# Path for the on-disk cache, or "none" to keep it in memory only.
# CACHE_FILE=./.cache/parts.json

# Parallel supplier requests (worker threads). Raising this speeds up large
# BOMs but makes rate limiting more likely.
LOOKUP_CONCURRENCY=3

# Largest BOM accepted in one analysis run.
MAX_PARTS_PER_REQUEST=500

# ── Screening ──────────────────────────────────────────────────────────────
# Part numbers starting with any of these are treated as in-house — assemblies,
# cables, drawings and bare boards — and are never sent to a supplier. Matching
# is case-insensitive and applies to the start of the part number only, so
# ASY0-1234 is skipped while XASY0-1234 is looked up normally.
# Set this to an empty value to look up everything.
IGNORE_PART_PREFIXES=ASY0,CBL0,DES0,PCB0

# A BOM carrying a "Skip to Production" column has its own say: lines marked
# YES in it are never sent to a supplier. The column is detected automatically
# and can be remapped or unmapped in the app; there is nothing to configure.
